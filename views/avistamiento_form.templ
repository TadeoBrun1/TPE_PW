package views

templ AvistamientoForm(){
    <form method="POST" action="/avistamientos">
        <label for="fecha_hora">
            Fecha y hora del suceso
            <input type="datetime-local" id="fecha_hora" name="fecha_hora" required/>
        </label>
        <label for="ubicacion">
			Ubicación
			<input type="text" id="ubicacion" name="ubicacion" required/>
		</label>
		<label for="descripcion">
			Descripción
			<textarea id="descripcion" name="descripcion" rows="3" required></textarea>
		</label>
		<label for="hubo_destrozos">
			<input type="checkbox" id="hubo_destrozos" name="hubo_destrozos"/>
			¿Hubo destrozos?
		</label>
		<label for="detalle_destrozos">
			Detalle de los destrozos (opcional)
			<textarea id="detalle_destrozos" name="detalle_destrozos" rows="2"></textarea>
		</label>
		<label for="imagen">
			Imagen (opcional)
			<input type="text" id="imagen" name="imagen"/>
		</label>
		<label for="nombre_reportante">
			Nombre de quien reporta (opcional)
			<input type="text" id="nombre_reportante" name="nombre_reportante"/>
		</label>
		<label for="email_reportante">
			Email de quien reporta (opcional)
			<input type="email" id="email_reportante" name="email_reportante"/>
		</label>
        <button type="submit">Enviar avistamiento</button>
    </form>
}
