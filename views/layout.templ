package views

templ Layout(titulo string){
    <!DOCTYPE html>
    <html lang="as">
        <head>
            <meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ titulo }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
        </head>
        <body>
            <main class="container">
                {children...}
           </main>
        </body>
    </html>  
}

